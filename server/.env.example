# Konfiguration des Mail-Dienstes (invite-api)
# Auf dem Server liegt die echte Datei unter /var/www/big5.rd-sim.de/invite-api/.env
# Nach jeder Änderung: systemctl restart big5-invite-api

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Big Five Test | rd-sim.de

# --- Schutz von POST /send-report ---
# Dieser Endpunkt ist bewusst ohne Basic Auth erreichbar, weil ihn der Browser der
# teilnehmenden Person aufruft. Die folgenden drei Werte verhindern, dass daraus ein
# offenes Mail-Relay wird.

# Empfänger, an die Ergebnisberichte im Lehrgangsmodus gehen dürfen.
# Komma-Liste; Einträge sind entweder vollständige Adressen oder Domains als "@beispiel.de".
# Nicht gesetzt = jeder Lehrgangsmodus-Versand wird mit 403 abgelehnt.
TRAINER_EMAILS=

# Dürfen Teilnehmende sich ihren Bericht selbst per Mail schicken (Feld auf der
# Ergebnisseite, nur außerhalb des Lehrgangsmodus)? Bei "false" bleibt nur der
# PDF-Download - der läuft rein im Browser und braucht den Server nicht.
# Achtung: "true" erlaubt den Versand an beliebige Adressen.
ALLOW_SELF_SEND=false

# Maximale Größe des dekodierten PDF-Anhangs in Bytes (Standard: 10 MB).
# Zum Vergleich: ein vollständiger Ergebnisbericht ist rund 1,5 MB groß.
MAX_PDF_BYTES=10485760
